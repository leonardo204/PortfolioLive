datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model Career {
  id               Int       @id @default(autoincrement())
  company          String
  companyType      String    @map("company_type")
  department       String
  position         String
  location         String
  startedAt        DateTime  @map("started_at")
  endedAt          DateTime? @map("ended_at")
  isCurrent        Boolean   @default(false) @map("is_current")
  techTransition   String?   @map("tech_transition")
  summary          String?
  sortOrder        Int       @default(0) @map("sort_order")
  // EN fields
  companyEn        String?   @map("company_en")
  departmentEn     String?   @map("department_en")
  positionEn       String?   @map("position_en")
  locationEn       String?   @map("location_en")
  techTransitionEn String?   @map("tech_transition_en")
  summaryEn        String?   @map("summary_en")
  workProjects     WorkProject[]

  @@map("careers")
}

model WorkProject {
  id          Int      @id @default(autoincrement())
  careerId    Int      @map("career_id")
  year        String
  title       String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  career      Career   @relation(fields: [careerId], references: [id])

  @@map("work_projects")
}

model PortfolioProject {
  id            Int       @id @default(autoincrement())
  slug          String    @unique
  title         String
  description   String?
  category      String?
  technologies  String[]  @default([])
  tags          String[]  @default([])
  year          String?
  githubUrl     String?   @map("github_url")
  liveUrl       String?   @map("live_url")
  // App Store 출시작 — 동기화할 때 README에서 자동으로 찾아 채운다.
  appStoreUrl   String?   @map("app_store_url")
  readmeRaw     String?   @map("readme_raw")
  sortOrder     Int       @default(0) @map("sort_order")
  // 대표작 — 첫 화면 맨 위에 크게 보여줄 프로젝트. 관리 화면에서 켜고 끈다.
  featured      Boolean   @default(false)
  featuredOrder Int       @default(0) @map("featured_order")
  lastSyncedAt  DateTime? @map("last_synced_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  // EN fields
  titleEn       String?   @map("title_en")
  descriptionEn String?   @map("description_en")
  readmeRawEn   String?   @map("readme_raw_en") @db.Text

  @@map("portfolio_projects")
}

model ChatSession {
  id           Int       @id @default(autoincrement())
  visitorId    String    @map("visitor_id")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  referrer     String?
  startedAt    DateTime  @default(now()) @map("started_at")
  endedAt      DateTime? @map("ended_at")
  messageCount Int       @default(0) @map("message_count")
  messages     ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  sessionId  Int      @map("session_id")
  role       String
  content    String
  modelUsed  String?  @map("model_used")
  tokensUsed Int?     @map("tokens_used")
  cost       Float?
  latencyMs  Int?     @map("latency_ms")
  createdAt  DateTime @default(now()) @map("created_at")
  session    ChatSession @relation(fields: [sessionId], references: [id])

  @@map("chat_messages")
}

model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  referrer  String?
  visitorId String?  @map("visitor_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("page_views")
}

model ChatAnalytics {
  id             Int      @id @default(autoincrement())
  sessionId      Int      @map("session_id")
  questionIntent String?  @map("question_intent")
  satisfaction   String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("chat_analytics")
}

model GuardrailEvent {
  id            Int      @id @default(autoincrement())
  sessionId     Int?     @map("session_id")
  ipAddress     String?  @map("ip_address")
  violationType String   @map("violation_type")
  message       String?
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("guardrail_events")
}

model ContactRequest {
  id           Int      @id @default(autoincrement())
  sessionId    Int?     @map("session_id")
  name         String
  organization String?
  email        String
  message      String
  ipAddress    String?  @map("ip_address")
  isRead       Boolean  @default(false) @map("is_read")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("contact_requests")
}

model AdminSetting {
  key       String   @id
  value     String
  isPublic  Boolean  @default(false) @map("is_public")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_settings")
}

/// 관리자 패스키(생체 인증 기기) 등록 정보.
/// 비밀번호를 대신하는 로그인 수단이라 기기 여러 대를 등록해 둘 수 있다.
/// publicKey는 공개키라 유출돼도 로그인에 쓰이지 않는다(서명은 기기 안 개인키가 한다).
model AdminCredential {
  id         String   @id                       // 기기가 준 자격 증명 ID (base64url)
  publicKey  Bytes    @map("public_key")
  counter    BigInt   @default(0)               // 재사용 공격 탐지용 서명 횟수
  transports String[] @default([])              // usb, nfc, ble, internal, hybrid
  deviceType String   @default("") @map("device_type")   // singleDevice | multiDevice
  backedUp   Boolean  @default(false) @map("backed_up")  // 기기 간 동기화 여부
  label      String                             // 목록에서 알아볼 이름 (예: 맥북 Touch ID)
  createdAt  DateTime @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  @@map("admin_credentials")
}

model CacheStore {
  key       String    @id
  value     Json
  expiresAt DateTime? @map("expires_at")

  @@map("cache_store")
}

/// 관리자 로그인 실패 기록과 차단 목록.
/// 비밀번호를 연달아 틀린 주소를 막는다. 패스키 로그인은 여기에 걸리지 않으므로
/// 본인이 오타로 잠겨도 등록해 둔 기기로 들어와 풀 수 있다.
model AdminLoginBlock {
  ip            String    @id
  failedCount   Int       @default(0) @map("failed_count")
  blocked       Boolean   @default(false)
  firstFailedAt DateTime  @default(now()) @map("first_failed_at")
  lastFailedAt  DateTime  @default(now()) @map("last_failed_at")
  blockedAt     DateTime? @map("blocked_at")
  lastUserAgent String?   @map("last_user_agent")
  note          String?

  @@index([blocked, lastFailedAt])
  @@map("admin_login_blocks")
}
