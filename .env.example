# PortfolioLive 환경변수
# 이 파일을 .env로 복사한 후 값을 채워주세요.
# cp .env.example .env

# AI 프록시 (ai.zerolive.co.kr) — LLM·임베딩 호출 경유
# 앱 토큰은 관리자에게 발급받습니다. 절대 커밋 금지.
AI_PROXY_URL=https://ai.zerolive.co.kr
AI_PROXY_TOKEN=
AI_EMBEDDING_MODEL=google/gemini-embedding-001
AI_EMBEDDING_DIMENSIONS=768
# 주 임베딩 모델이 상류 쿼터로 막혔을 때 쓰는 예비 모델.
# 벡터 공간이 달라 예비 색인(embeddings_fallback)에서만 검색합니다.
AI_EMBEDDING_FALLBACK_MODEL=openai/text-embedding-3-large

# RAG 충분도 판정 기준 (이 값을 넘는 결과가 RAG_MIN_RESULTS건 미만이면 웹 검색으로 보강)
RAG_MIN_SIMILARITY=0.63
RAG_MIN_SIMILARITY_FALLBACK=0.44
RAG_MIN_RESULTS=2

# 방문 기록 대시보드(ai.zerolive.co.kr) 전송용 토큰.
# 비워 두면 기록을 보내지 않고 화면은 그대로 동작합니다.
TRAFFIC_TOKEN=

# Database (Docker PostgreSQL)
POSTGRES_DB=portfoliolive
POSTGRES_USER=portfoliolive
# POSTGRES_PASSWORD: 강력한 랜덤 패스워드 필수.
# 'changeme', 'postgres', 'admin' 등 예측 가능한 값 절대 금지.
# 생성: openssl rand -base64 32
POSTGRES_PASSWORD=

# GitHub (Personal Access Token - repo read)
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# Admin
ADMIN_PASSWORD=

# 패스키(생체 인증) 로그인 — 기본값은 공개 주소에서 자동으로 정해진다.
# 다른 도메인이나 localhost에서 시험할 때만 채운다.
# PASSKEY_RP_ID=me.zerolive.co.kr
# PASSKEY_ORIGINS=https://me.zerolive.co.kr
# PASSKEY_RP_NAME=Leonardo204 Admin

# Admin 세션 HMAC 서명 비밀키 (32자 이상 필수)
# 생성: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# SMTP Email (Gmail 앱 비밀번호)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
ADMIN_EMAIL=

# Ports (기존 서비스 충돌 방지용 private port)
WEB_PORT=3100
AGENT_PORT=3101
# POSTGRES_PORT: 호스트 측 dev 접근용 포트 (loopback 전용 바인딩).
# docker-compose.yml에서 127.0.0.1에만 바인딩됨. 절대 0.0.0.0으로 변경 금지.
# 외부 접근이 필요하면 SSH 터널 또는 VPN 경유.
POSTGRES_PORT=5433
